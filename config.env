# ─────────────────────────────────────────────────────────────────────────────
# Content to Commerce - configuration
# Edit the values below, save, and run again. Lines starting with # are notes.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Cloud / Vertex AI (Gemini) ────────────────────────────────────────
# Your Google Cloud project id (Vertex AI API must be enabled in it).
GCP_PROJECT_ID=your-project-id
# Vertex AI location. "global" serves Gemini 3.1 Flash-Lite.
GCP_LOCATION=global
# Gemini model used to describe each outfit.
GEMINI_MODEL=gemini-3.1-flash-lite
# Login: run `gcloud auth application-default login` once (recommended), or
# point this at a service-account key file (path relative to this folder):
# GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# ── Video sampling ───────────────────────────────────────────────────────────
# Frames analysed per second of video (1 = one frame per second). Higher finds
# short outfit appearances but takes longer.
SAMPLE_FPS=1
# Shot-boundary detection: higher = fewer cuts detected; minimum frames between cuts.
SHOT_CUT_THRESHOLD=3.0
SHOT_MIN_FRAMES=15

# ── Main characters ──────────────────────────────────────────────────────────
# How many main characters to keep (ranked by screen time), 1-10.
MAIN_CHARACTERS=3
# Face clustering threshold: lower merges fewer faces into one character.
FACE_TAU=0.45

# ── Hardware ─────────────────────────────────────────────────────────────────
# auto = Apple silicon GPU (mps) on a Mac, NVIDIA GPU (cuda) on a PC, otherwise cpu
DEVICE=auto
# Person detector: yolo11n (fastest) | yolo11s (default) | yolo11m (most accurate)
PERSON_DETECTOR=yolo11s

# ── Gemini request limits ────────────────────────────────────────────────────
# Requests sent per minute and at the same time. If you see many "429 resource
# exhausted" retries in the log, lower GEMINI_RPM.
GEMINI_RPM=60
GEMINI_CONCURRENCY=8
# Safety cap on requests per day.
GEMINI_RPD=5000
